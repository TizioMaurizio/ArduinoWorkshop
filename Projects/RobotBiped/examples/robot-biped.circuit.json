  "code": "/*\n * Robot Biped — 10-DOF Walking Robot\n * Target Board: Arduino Uno\n *\n * Wiring:\n *   Arduino A4 (SDA) → PCA9685 SDA\n *   Arduino A5 (SCL) → PCA9685 SCL\n *   Arduino 5V       → PCA9685 VCC (logic power)\n *   Arduino GND      → PCA9685 GND (common ground)\n *   External 5V PSU  → PCA9685 V+ (servo power, 2A+ recommended)\n *\n * PCA9685 Channel → Joint Mapping:\n *   ch0  → Left Ankle X     ch11 → Right Hip Z\n *   ch1  → Left Ankle Y     ch12 → Right Hip Y\n *   ch2  → Left Knee         ch13 → Right Knee\n *   ch3  → Left Hip Y        ch14 → Right Ankle Y\n *   ch4  → Left Hip Z        ch15 → Right Ankle X\n *   ch5–ch10 → Unused\n *\n * Serial Protocol: s[16×3-digit angles]\\n at 115200 baud\n * Example: s090102121091080000000000000000000104095072073090\\n\n *\n * Dependencies:\n *   - Adafruit PWM Servo Driver Library\n *   - Wire (built-in)\n */\n\n#include <Wire.h>\n#include <Adafruit_PWMServoDriver.h>\n\n#define SERVOMIN  125\n#define SERVOMAX  575\n#define SERVONUM  16\n#define INTERVAL  30\n\nAdafruit_PWMServoDriver pwm = Adafruit_PWMServoDriver();\n\nint servos[16]      = {90, 102, 121, 91, 80, 90, 90, 90, 90, 90, 90, 104, 95, 72, 73, 90};\nint targetPoses[16] = {90, 102, 121, 91, 80, 90, 90, 90, 90, 90, 90, 104, 95, 72, 73, 90};\n\nint angleToPulse(int ang) {\n  return map(ang, 0, 180, SERVOMIN, SERVOMAX);\n}\n\nint sign(int x) {\n  return (x > 0) - (x < 0);\n}\n\nvoid setup() {\n  pwm.begin();\n  pwm.setPWMFreq(60);\n  Serial.begin(115200);\n  Serial.setTimeout(5);\n  for (int i = 0; i < 16; i++) {\n    pwm.setPWM(i, 0, angleToPulse(servos[i]));\n  }\n}\n\nvoid loop() {\n  if (Serial.available()) {\n    if (Serial.read() != 's') return;\n    String msg = Serial.readString();\n    if (msg.length() != SERVONUM * 3 + 1) {\n      Serial.println(\"Invalid\");\n      return;\n    }\n    for (int i = 0; i < SERVONUM; i++) {\n      targetPoses[i] = msg.substring(i*3, i*3+3).toInt();\n    }\n    Serial.print(msg);\n  }\n  static unsigned long prev = 0;\n  if (millis() - prev >= INTERVAL) {\n    prev = millis();\n    for (int i = 0; i < 16; i++) {\n      if (servos[i] != targetPoses[i]) {\n        int d = targetPoses[i] - servos[i];\n        servos[i] += (abs(d) <= 2) ? d : 2 * sign(d);\n        pwm.setPWM(i, 0, angleToPulse(servos[i]));\n      }\n    }\n  }\n}\n",
  "exportedAt": "2026-05-15T00:00:00.000Z"
}
