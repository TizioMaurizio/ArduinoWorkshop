# PlatformIO build output
.pio/

# Python bytecode
__pycache__/
*.pyc

# Python virtual environments
.venv/

# Runtime logs
logs/

# Pytest cache
.pytest_cache/

# Local config (contains real serial port / baud — use config.example.yaml)
config.yaml

# IDE / editor
.vscode/

# Backup files
*.bak

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store
*.lnk

# Research PDFs (large binaries — store elsewhere)
*.pdf

# Scratch / test Godot projects
Projects/ESP32-CAM-PlatformIO/GodotMinimalXR/

# ELEGOO vendor documentation and reference code (large, not ours)
Projects/ESP32-CAM-PlatformIO/drone_control/

# Vite cache
.vite/

# Video files (large binaries)
*.mp4

# Godot build/import cache
.godot/

# Generated media (extracted frames, processed output)
**/Media/input/
**/Media/output/
**/Media/old/

# Stray Godot exports at repo root
/icon.png
/icon.svg

# Copilot memory (local workspace state, not shared)
memories/

# Auto-generated servo state files
.servo_settings.json
.servo_recordings.json

# Simulation and test scaffolding (generated)
test/
